{
  "name": "policydrift",
  "private": true,
  "version": "1.0.0",
  "description": "PolicyDrift — full-stack news platform (Express + MySQL + Next.js 14)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "check": "npm run check -w policydrift-backend",
    "ingest": "npm run ingest -w policydrift-backend",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w policydrift-backend\" \"dotenv -e .env -- node scripts/web-dev.mjs\"",
    "dev:api": "npm run dev -w policydrift-backend",
    "dev:web": "dotenv -e .env -- node scripts/web-dev.mjs",
    "build": "dotenv -e .env -- npm run build -w policydrift-frontend",
    "start:api": "npm run start -w policydrift-backend",
    "start:web": "dotenv -e .env -- node scripts/web-start.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0"
  }
}
