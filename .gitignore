# ─── Playwright / Scraper browser profiles ────────────────────────────────────
# Large persistent browser profile — NEVER push to git
cricbuzz_scraper/browser_profile/

# ─── Live scraped data (runtime-generated, large, constantly changing) ────────
# These are produced by the scraper daemon at runtime — not source code
backend/data/cricket/
backend/data/football/

# DO NOT ignore these — they ARE source code:
# backend/src/controllers/
# backend/src/routes/
# cricbuzz_scraper/*.py

# ─── PM2 / ecosystem ──────────────────────────────────────────────────────────
