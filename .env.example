# NewsFree365 — Environment Configuration Template
# Copy to .env.development or .env.production as needed

# --- MySQL Database ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=policydrift_news
MYSQL_POOL_LIMIT=10

# --- Server Ports ---
API_PORT=4050
WEB_PORT=3050
API_INTERNAL_URL=http://localhost:4050

# --- RSS Real-Time Monitoring & Article Extraction ---
RSS_POLL_INTERVAL=60000
RSS_REQUEST_TIMEOUT=15000
RSS_MAX_RETRIES=3
RSS_EXTRACT_FULL_ARTICLE=true
RSS_CRON_INTERVAL_MINUTES=1
RSS_FEED_URLS=https://feeds.bbci.co.uk/news/politics/rss.xml

# --- Background Worker ---
CRON_ENABLED=true
WORKER_ENABLED=true

# --- Google Trends ---
TRENDS_ENABLED=true
TRENDS_GEO=IN
TRENDS_CRON=*/30 * * * *
TRENDS_REQUEST_DELAY_MS=3500
TRENDS_REFRESH_SECRET=newsfree365_trends_refresh

# --- Admin Authentication ---
ADMIN_SECRET=Raunak@123
INSIGHTS_ADMIN_SECRET=Raunak@123

# --- Next.js Public URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4050
NEXT_PUBLIC_SITE_URL=http://localhost:3050
CORS_ORIGIN=http://localhost:3050,http://127.0.0.1:3050

# --- Telegram Automated Channel Broadcast ---
TELEGRAM_BOT_TOKEN=8812419326:AAHq9BmIhYhi-gby9-kQevx2JalXyS1BaDk
TELEGRAM_CHAT_ID=@newsfree365 

# --- WhatsApp Automated Dispatch (Optional Webhook or Meta Cloud API) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENT_NUMBER=
