# Copy to .env.development and/or .env.production and fill in values.
# Prefer the env-specific files:
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# Scripts:
#   npm run dev          → .env.development
#   npm run build:dev    → .env.development (Next NEXT_PUBLIC_* for local)
#   npm run build        → .env.production  (alias of build:prod)
#   npm run build:prod   → .env.production
#   npm run start:web    → .env.production
#   pm2 start            → NODE_ENV=production → .env.production

# --- MySQL (backend) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=policydrift_news
MYSQL_POOL_LIMIT=10

# --- Server ---
NODE_ENV=development
# development: API 4001 / web 3001 | production: API 4000 / web 3000
API_PORT=4001
WEB_PORT=3001
API_INTERNAL_URL=http://localhost:4001

# --- RSS ---
RSS_FEED_URLS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CRON_ENABLED=true

# --- Google Trends ---
TRENDS_ENABLED=true
TRENDS_GEO=IN
TRENDS_CRON=*/30 * * * *
TRENDS_REQUEST_DELAY_MS=3500
TRENDS_REFRESH_SECRET=

# --- CORS ---
# development: http://localhost:3001
# production:  https://www.policydrift.live,https://policydrift.live
CORS_ORIGIN=http://localhost:3001

# --- Public API / site (inlined into Next at build time) ---
# development: http://localhost:4001 / http://localhost:3001
# production:  https://www.policydrift.live
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

NEXT_PUBLIC_CURATOR_NAME=PolicyDrift Editorial
NEXT_PUBLIC_CURATOR_ROLE=News desk
NEXT_PUBLIC_CURATOR_BIO=Stories are curated from top RSS sources
NEXT_PUBLIC_CURATOR_URL=http://localhost:3001
NEXT_PUBLIC_CURATOR_IMAGE_URL=http://localhost:3001/icon.svg

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- Admin ---
INSIGHTS_ADMIN_SECRET=
INSIGHTS_ADMIN_RATE_WINDOW_MS=900000
INSIGHTS_ADMIN_RATE_MAX=60
INSIGHTS_PUBLIC_RATE_WINDOW_MS=60000
INSIGHTS_PUBLIC_RATE_MAX=120

# Optional
# INDEXNOW_KEY=
# TRENDS_ENABLED=false
# TRENDS_REFRESH_SECRET=
