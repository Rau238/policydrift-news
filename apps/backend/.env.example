# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For MongoDB Atlas (Cloud - Free Tier):
# 1. Sign up at https://www.mongodb.com/cloud/atlas/register
# 2. Create a free cluster (M0)
# 3. Create a database user (username/password)
# 4. Whitelist your IP (or use 0.0.0.0/0 for all IPs)
# 5. Get connection string and replace below:
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/news_website?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production_min_32_characters
JWT_REFRESH_EXPIRE=30d

# Cloudinary (for image uploads)
# Sign up at https://cloudinary.com for free account
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (NodeMailer with Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@newswebsite.com
EMAIL_FROM_NAME=News Website

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
